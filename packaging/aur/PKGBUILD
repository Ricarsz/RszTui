# Maintainer: Ricarsz <Ricarsz@users.noreply.github.com>
pkgname=rogtui
pkgver=1.4.0
pkgrel=1
pkgdesc="Terminal control panel for ASUS TUF laptops using asusctl and NetworkManager"
arch=('x86_64' 'aarch64')
url="https://github.com/Ricarsz/rogtui"
license=('MIT')
depends=('glibc' 'gcc-libs')
makedepends=('cargo')
optdepends=(
  'asusctl: ASUS performance, battery, fan and lighting control'
  'networkmanager: Wi-Fi, IPv4/DNS, VPN and hotspot management'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('59ab85d228e5c9343e564f04eb9c40b366d96ca598c15992ea76f3c68fa78a94')

prepare() {
  cd "rogtui-$pkgver"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "rogtui-$pkgver"
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "rogtui-$pkgver"
  export CARGO_TARGET_DIR=target
  cargo test --frozen --release
}

package() {
  cd "rogtui-$pkgver"
  install -Dm755 target/release/rogtui "$pkgdir/usr/bin/rogtui"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm755 scripts/setup-nopasswd.sh "$pkgdir/usr/share/$pkgname/setup-nopasswd.sh"
  install -Dm755 scripts/remove-nopasswd.sh "$pkgdir/usr/share/$pkgname/remove-nopasswd.sh"
}
