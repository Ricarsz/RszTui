# Maintainer: Ricarsz <Ricarsz@users.noreply.github.com>
pkgname=rsztui
pkgver=1.2.1
pkgrel=1
pkgdesc="Terminal control panel for ASUS TUF laptops using asusctl and NetworkManager"
arch=('x86_64' 'aarch64')
url="https://github.com/Ricarsz/RszTui"
license=('MIT')
depends=('glibc' 'gcc-libs')
makedepends=('cargo')
optdepends=(
  'asusctl: ASUS performance, battery, fan and lighting control'
  'networkmanager: Wi-Fi, IPv4/DNS, VPN and hotspot management'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('22d89e8f03542fb4ca87bc152920dc4fcaaffbdd90c7fe7a87b4e9684959ce2c')

prepare() {
  cd "RszTui-$pkgver"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "RszTui-$pkgver"
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "RszTui-$pkgver"
  export CARGO_TARGET_DIR=target
  cargo test --frozen --release
}

package() {
  cd "RszTui-$pkgver"
  install -Dm755 target/release/rsztui "$pkgdir/usr/bin/rsztui"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm755 scripts/setup-nopasswd.sh "$pkgdir/usr/share/$pkgname/setup-nopasswd.sh"
  install -Dm755 scripts/remove-nopasswd.sh "$pkgdir/usr/share/$pkgname/remove-nopasswd.sh"
}
